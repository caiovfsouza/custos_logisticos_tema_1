let divsComDataPage=document.querySelectorAll("div[data-page]"),autoPagerDivs=document.querySelectorAll("div.auto-pager");function appendThemaRating(e){e.forEach((a,t)=>{let i=a.nextElementSibling;if(i&&"MODULE"===i.tagName){let l=i.nextElementSibling;if("apresentacao"===i.getAttribute("data-module")||l&&"YDUQS-MODULE-COVER"===l.tagName||"conclusao"===i.getAttribute("id"))return}if(t===e.length-1)return;let n=document.createElement("yduqs-card-like-dislike");a.appendChild(n)})}divsComDataPage.length>0?appendThemaRating(divsComDataPage):autoPagerDivs.length>0?appendThemaRating(autoPagerDivs):console.log("");